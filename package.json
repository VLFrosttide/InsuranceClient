{
  "name": "insurance-client",
  "productName": "Insurance",
  "version": "1.0.5",
  "description": "Insurance client",
  "license": "ISC",
  "author": "Frosttide",
  "type": "module",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/VLFrosttide/InsuranceClient.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node Test/reconcile.test.cjs",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish always",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.frosttide.insuranceclient",
    "productName": "Insurance",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "renderer/**/*",
      "Icons/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "VLFrosttide",
        "repo": "InsuranceClient",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "Icons/frosttide23.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
